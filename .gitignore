# Visual Studio / .NET 项目常见忽略

# 用户特定设置文件
*.suo
*.user
*.userosscache
*.sln.docstates
*.rsuser

# VS 工程生成的缓存与索引
.vs/
[Ll]og/

# trae配置文件
.trae/

# 构建产物（Debug/Release、二进制输出等）
[Bb]in/
[Oo]bj/
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]elease-*/
x86/
x64/

# 测试输出与覆盖率
[Tt]est[Rr]esult*/
TestResult.xml
*.trx
*.coverage
*.coveragexml

# NuGet（使用 packages 管理时）
packages/**
**/packages/**
!**/packages/build/
!**/packages/repositories.config
*.nupkg
*.snupkg
.nuget/

# 发布与签名（VSTO/ClickOnce 常见）
publish/
*.pfx
*.cer
*.application
*.manifest
*.vsto
*.deploy
*.publishsettings
*.pubxml.user

# ReSharper / Rider 等工具
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user

# 备份/临时文件
*.bak
*.tmp
*.temp
~$*

# Windows 系统文件
Thumbs.db
ehthumbs.db
Desktop.ini

# 可选：VSCode 工作区（如不需要共享）
.vscode/